# ── LLM & Embedding ──────────────────────────────────────
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=2048
LLM_MODEL_FAST=qwen3.5-flash
LLM_MODEL_STRONG=qwen3-max

# ── Milvus ───────────────────────────────────────────────
MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_USER=admin
MILVUS_PASSWORD=your_password_here

# ── MongoDB ──────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=your_password_here
MONGO_DATABASE=ai_fault_diagnosis

# ── Neo4j ───────────────────────────────────────────────
NEO4J_PASSWORD=your_neo4j_password_here

# ── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ── Elasticsearch ────────────────────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your_password_here
ES_SCHEME=http              # 本地/测试用 http，生产环境有 SSL 证书用 https

# ── Collections ──────────────────────────────────────────
COLLECTION_MANUAL=manual_total
COLLECTION_MANUAL_CHUNKS=manual_chunks
COLLECTION_WORKORDER=workorder

# ── Vector Search ────────────────────────────────────────
VECTOR_SEARCH_SCORE_THRESHOLD=0.6
ENTITY_BOOST_FACTOR=1.2

# ── Backend ──────────────────────────────────────────────
BACKEND_PORT=10090
JWT_SECRET=your_jwt_secret_here
