# ============================================================
# serving/.env.example — 后端服务环境变量模板
# 复制为 .env.local 并填入真实值
# ============================================================

# ── LLM & Embedding ──────────────────────────────────────
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v4

# ── 模型配置 ─────────────────────────────────────────────
# 通用模型
OPENAI_MODEL=qwen3-max

# Knowledge 场景
KNOWLEDGE_STEP1_MODEL=qwen3.5-flash
KNOWLEDGE_LANE2_MODEL=qwen3-max

# Fault Diagnose 场景（双速架构）
LANE_A_DECISION_MODEL=qwen3.5-flash
LANE_A_GENERATION_MODEL=qwen3-max
LANE_A_GENERATION_MAX_TOKENS=2000
LANE_A_LLM_TIMEOUT=60.0
LANE_A_GENERATION_TIMEOUT=120.0
FAULT_DIAGNOSE_STEP1_MODEL=qwen3.5-flash
FAULT_DIAGNOSE_STEP2_MODEL=qwen3-max
FAULT_DIAGNOSE_STEP3_MODEL=qwen3-max
FAULT_DIAGNOSE_LANE2_MODEL=qwen3-max
FAULT_DIAGNOSE_LANE3_MODEL=qwen3-max

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ai_fault_diagnosis
DB_USER=aiplatform
DB_PASSWORD=aiplatform

# ── MongoDB ───────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=your_password_here
MONGO_DATABASE=ai_fault_diagnosis
MONGO_AUTH_SOURCE=admin

# ── Neo4j ─────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis-asr
REDIS_PORT=6379
REDIS_PASSWORD=your_password_here
REDIS_DB=0

# ── Milvus ────────────────────────────────────────────────
MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_USER=xmanubot
MILVUS_PASSWORD=your_password_here

# ── Elasticsearch ─────────────────────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your_password_here
ES_SCHEME=http

# ── JWT 认证 ──────────────────────────────────────────────
AFTERSALES_SECRET_KEY=your_jwt_secret_here
FACTORY_SECRET_KEY=your_factory_secret_here
CONTROLLER_SECRET_KEY=your_controller_secret_here
ENABLE_AUTHENTICATION=true

# ── 应用端口 ──────────────────────────────────────────────
APP_PORT=10090
FRONTEND_BASE_URL=http://localhost:9097

# ── 知识库 Collection 配置 ────────────────────────────────
# 每个 Type 对应一个 search tool
# 支持逗号分隔多个 collection name，检索时并行查询
# 留空则该类型不参与检索

# 说明书（search_manual_knowledge 工具）
COLLECTION_MANUAL=manual_total,manual_chunks

# 技术文档（search_principle_knowledge 工具）
COLLECTION_PRINCIPLE=principle_total,principle_chunks

# 维修文档（search_repair_doc_knowledge 工具）
COLLECTION_REPAIR=repair_doc_chunks

# 工单-普通（search_workorder_knowledge 工具，走 Milvus）
COLLECTION_WORKORDER=workorder,special_workorder

# 工单-图谱（search_workorder_knowledge 工具，走 Neo4j）
# 固定标识符，通常不需要修改
COLLECTION_WORKORDER_GRAPH=workorder_graph

# 参数（search_parameter_knowledge 工具）
COLLECTION_PARAMETER=parameter_updated

# ── 检索配置 ──────────────────────────────────────────────
VECTOR_SEARCH_SCORE_THRESHOLD=0.7
ENABLE_RERANKER=1
USE_CARD_MODE=0

# ── 日志配置 ──────────────────────────────────────────────
LOG_LEVEL=INFO
LLM_DEBUG=0
LOG_TOPICS=flow,perf
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_FILE_MAX_SIZE=10 MB
LOG_FILE_RETENTION=10

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9097,http://localhost:3000
