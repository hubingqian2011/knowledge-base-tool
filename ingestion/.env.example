# ============================================================
# .env.example — 复制为 .env 并填入真实值
# ============================================================

# ---- LLM（阿里云 DashScope）-----------------------------------
# text-embedding-v4 输出 1024 维向量
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_text=qwen3-max
LLM_MODEL_embedding=text-embedding-v4
LLM_MODEL_VISUAL=qwen3.6-plus
LLM_MODEL_MULTIMODAL=qwen3.6-plus

# ---- MongoDB --------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=mongo
MONGO_PASSWORD=your_password_here
MONGO_DATABASE=ai_fault_diagnosis
MONGO_AUTH_SOURCE=admin

# ---- Elasticsearch --------------------------------------------
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=elastic
ES_SCHEME=http

# ---- Milvus ---------------------------------------------------
MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_USER=xmanubot
MILVUS_PASSWORD=xmanubot

# ---- 可选：覆盖并发控制 ---------------------------------------
# AGENT1_MAX_CONCURRENT_TEXT_REQUESTS=8
# AGENT1_MAX_CONCURRENT_VISUAL_REQUESTS=4
# AGENT1_MAX_CONCURRENT_DOCUMENTS=2
